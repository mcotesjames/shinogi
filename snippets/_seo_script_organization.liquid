<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo -%}
      "logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {%- endif %}
    {%- assign sameAs_json = '' -%}
    {%- if settings.social_instagram_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_instagram_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_facebook_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_twitter_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_twitter_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_pinterest_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_tiktok_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_youtube_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_youtube_link | json }}{%- endcapture -%}{%- endif -%}
    {%- if settings.social_vimeo_link != blank -%}{%- if sameAs_json != blank -%}{%- assign sameAs_json = sameAs_json | append: ',' -%}{%- endif -%}{%- capture sameAs_json -%}{{ sameAs_json }}{{ settings.social_vimeo_link | json }}{%- endcapture -%}{%- endif -%}
    "sameAs": [{{ sameAs_json }}],
    "url": {{ shop.url | append: page.url | json }}
  }
</script>